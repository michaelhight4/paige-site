    for nm, kinds in GEOM_PROPS.items():
        if nm not in M: continue
        m = M[nm]
        for sid in kinds:
            pat = re.compile(GEOM_TILE[sid]); hits = [(x, y) for y, r in enumerate(m.deco) for x, n in enumerate(r) if n and pat.fullmatch(n)]
