+# ==== SIGNS (Oct 23 2026, 3 AM CT): every sign entry on its sign tile, readable from the tile in front of it ====
+# settle() no longer moves sign entries (see the sign fix there). Here every entry on a 'sign' tile in the overnight maps gets
+# read_from = the side the player stands on to read it: below first ('down', the front), else the side that faces the path
+# (left/right/up). That cell must be walkable, free of npcs/items/warps and reachable with no field skill (R0).
+_SIGNS = []
+_SIDE = (('down', 0, 1), ('left', -1, 0), ('right', 1, 0), ('up', 0, -1))
+for _n in ON_ORDER:
+    _mm = ON[_n]; _R0 = None
+    for _e in _mm.signs + _mm.signs_pending:
+        if _mm.deco[_e['y']][_e['x']] != 'sign': continue
+        assert '[settled from' not in (_e.get('note') or ''), (_n, _e['id'])
+        if _R0 is None:
+            _R0 = _reach(_mm, False)
+            _occ = {(o['x'], o['y']) for o in _mm.npcs + _mm.npcs_pending + _mm.items} | {(w['x'], w['y']) for w in _mm.warps}
+        _ok = [f for f, dx, dy in _SIDE if (_e['x'] + dx, _e['y'] + dy) in _R0 and not _blk(_mm, _e['x'] + dx, _e['y'] + dy) and (_e['x'] + dx, _e['y'] + dy) not in _occ]
+        assert _ok, ('sign not readable', _n, _e['id'], _e['x'], _e['y'])
+        if _e.get('read_from'): assert _e['read_from'] in _ok, ('read_from blocked', _n, _e['id'], _e['read_from'], _ok)
+        else: _e['read_from'] = _ok[0]
+        _SIGNS.append((_n, _e['id'], _e['x'], _e['y'], _e['read_from']))
+print('SIGNS on tile:', len(_SIGNS), 'read_from:', {f: sum(1 for s in _SIGNS if s[4] == f) for f, _, _ in _SIDE})
+for _s in _SIGNS: print('SIGN', *_s)
