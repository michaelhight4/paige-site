BIN_LINES = [   # bin_stage = brookhollow.json bin_stages: stage = Master coins earned -> bin_ron_<stage>; flies from 6; finale_done -> empty
 L("bin_empty", ["Empty. Scrubbed clean. Not a single fly.", "Ron took the bags out. Bin day finally came."],
